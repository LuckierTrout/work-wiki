{
	// yopedia — Cloudflare Worker deployment via @opennextjs/cloudflare
	//
	// Binding names match src/lib/storage/cloudflare-types.ts CloudflareEnv:
	//   YOPEDIA_BUCKET   → R2Bucket
	//   YOPEDIA_CONFIG   → KVNamespace
	//   YOPEDIA_VECTORIZE → VectorizeIndex (optional)
	//
	// After provisioning resources, update bucket_name / id / index_name
	// to match your Cloudflare account. Run:
	//   npx wrangler r2 bucket list
	//   npx wrangler kv namespace list
	//   npx wrangler vectorize list
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yopedia",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "workwiki.app",
			"custom_domain": true
		},
		{
			"pattern": "www.workwiki.app",
			"custom_domain": true
		}
	],
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Persist Worker logs (errors/warns from e.g. illustration generation) so they
	// can be queried after the fact via `wrangler tail` / the dashboard, not just
	// live-streamed.
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// --- R2: Primary storage (wiki pages, raw sources, assets) ---
	"r2_buckets": [
		{
			"binding": "YOPEDIA_BUCKET",
			"bucket_name": "yopedia-raw"
		}
	],
	// --- KV: Config and derived indexes ---
	"kv_namespaces": [
		{
			"binding": "YOPEDIA_CONFIG",
			"id": "874e4a8165ff4725ad24b4dfd62d479b"
		}
	],
	// --- Vectorize: bge-m3 emits fixed 1024-dimensional vectors ---
	"vectorize": [
		{
			"binding": "YOPEDIA_VECTORIZE",
			"index_name": "yopedia-embeddings-bge-m3"
		}
	],
	// --- Workers AI: serverless embeddings (e.g. @cf/baai/bge-m3 for CJK) ---
	"ai": {
		"binding": "AI"
	},
	// --- Sandbox: private Worker-to-Worker service binding. Deploy the sandbox
	// worker first, then set YOPEDIA_SANDBOX_TOKEN as the same Wrangler secret on
	// both workers. Local development can fall back to YOPEDIA_SANDBOX_URL. ---
	"services": [
		{
			"binding": "YOPEDIA_SANDBOX",
			"service": "yopedia-sandbox-runner"
		}
	],
	// --- Queues: producer for the agent task queue (async maintenance + ingest).
	// The consumer is a separate worker (workers/task-consumer/). enqueueTask()
	// (src/lib/tasks.ts) sends here; it no-ops gracefully when this binding is
	// absent (local dev / next start / tests). One-time provisioning:
	//   npx wrangler queues create yopedia-tasks
	//   npx wrangler queues create yopedia-tasks-dlq
	"queues": {
		"producers": [
			{
				"binding": "TASK_QUEUE",
				"queue": "yopedia-tasks"
			}
		]
	},
	// --- Email: optional owner source-monitor digest delivery. Destinations must
	// be verified in Cloudflare Email Routing; the address itself stays in the
	// owner's private Yopedia settings rather than deployment configuration. ---
	"send_email": [
		{
			"name": "MONITOR_DIGEST_EMAIL",
			"allowed_sender_addresses": ["ingest@workwiki.app"]
		}
	],
	// Public site-owner handle for runtime server gates (owner-only Lint). The
	// authoritative copy for the client is the build-time inline (deploy
	// workflow); this is runtime parity for server reads. Public, not a secret.
	//
	// AUTONOMOUS_MAINTENANCE="on" enables the daily maintenance cron to actually
	// enqueue maintain tasks (reconcile disputes, refresh stale pages, and the
	// deterministic janitorial fixes). Anything other than "on" = dry-run.
	// See workers/task-consumer/README.md.
	"vars": {
		"NEXT_PUBLIC_OWNER_HANDLE": "christianlee",
		"NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
		"NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/",
		// Stable Clerk production user id. Middleware fails closed when this is
		// missing or does not match, so no other signed-in account can read the app.
		"YOPEDIA_OWNER_USER_ID": "user_3HQlxnUOlZqWjrqgjtIrkKE4nFK",
		"AUTONOMOUS_MAINTENANCE": "on",
		"YOPEDIA_EMAIL_ROUTING_READY": "1",
		"YOPEDIA_SITE_URL": "https://workwiki.app",
		"YOPEDIA_MONITOR_EMAIL_FROM": "ingest@workwiki.app",
		"EMBEDDING_PROVIDER": "workers-ai",
		"EMBEDDING_MODEL": "@cf/baai/bge-m3"
	}
}
