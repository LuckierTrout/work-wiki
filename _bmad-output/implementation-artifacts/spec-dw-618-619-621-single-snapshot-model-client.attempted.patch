+// ---------------------------------------------------------------------------
+// One config generation per model client (DW-618) and the workload-aware
+// gate (DW-621)
+// ---------------------------------------------------------------------------
+
+/**
+ * Run `body` under a clock whose every read lands ten minutes after the one
+ * before it, so the config cache is stale by the time ANY `loadConfigSync()`
+ * would read it.
+ *
+ * This is the DW-334 `withClockSpy` idiom from `config.test.ts` pushed one
+ * layer out: that helper COUNTS `loadConfigSync` entries and cannot span an
+ * `async` function that awaits `loadConfig()` itself. An always-advancing clock
+ * needs no counting — under it a second entry into the 5 s-TTL cache can only
+ * answer the cold-cache `{}`, so the assertion is simply that the constructed
+ * client still carries the STORED key, endpoint and model. Threaded code never
+ * re-enters the cache at all and passes; the pre-fix code fell to `{}` and
+ * either refused the provider or built a client out of two generations.
+ *
+ * Safe because `loadConfigSync`'s TTL check is the only clock read on any path
+ * reached here — the other `Date.now()` in range is `storage/filesystem.ts`'s
+ * WRITE lock loop, and every `store()` below happens before the spy goes in.
+ */
+async function underStaleCache<T>(body: () => Promise<T>): Promise<T> {
+  const t0 = Date.now();
+  let read = 0;
+  const clock = vi.spyOn(Date, "now").mockImplementation(() => t0 + read++ * 600_000);
+  try {
+    return await body();
+  } finally {
+    clock.mockRestore();
+  }
+}
+
+describe("one model client comes from one config generation (DW-618)", () => {
+  const WORKLOAD_CUSTOM: AppConfig = {
+    chatProvider: "custom",
+    chatModel: "chat-model",
+    customApiKey: "sk-custom",
+    customBaseUrl: "https://api.example/v1",
+  };
+
+  it("builds a WORKLOAD client from the snapshot its own loadConfig() returned", async () => {
+    // `getConfiguredModel` awaited `loadConfig()` and then DISCARDED it, so the
+    // workload settings, the key and the base URL were three separate entries
+    // into a 5 s-TTL cache. A cache that expires between them hands the later
+    // legs the cold `{}` — and a correctly configured Custom deployment is
+    // refused, or worse, half-built.
+    await store(WORKLOAD_CUSTOM);
+    createOpenAIMock.mockClear();
+
+    await underStaleCache(() => getConfiguredModel({ workload: "chat" }));
+
+    expect(createOpenAIMock).toHaveBeenLastCalledWith({
+      apiKey: "sk-custom",
+      baseURL: "https://api.example/v1",
+    });
+    expect(createOpenAIMock.mock.results[0].value.chat).toHaveBeenCalledWith(
+      "chat-model",
+    );
+  });
+
+  it("builds the PRIMARY client from that same one snapshot", async () => {
+    await store(CUSTOM);
+    createOpenAIMock.mockClear();
+
+    await underStaleCache(() => getConfiguredModel());
+
+    expect(createOpenAIMock).toHaveBeenLastCalledWith({
+      apiKey: "sk-custom",
+      baseURL: "https://api.example/v1",
+    });
+    expect(createOpenAIMock.mock.results[0].value.chat).toHaveBeenCalledWith("my-model");
+  });
+
+  it("does the same for callLLM, which straddled the identical snapshot", async () => {
+    // `callLLM`, `callLLMStream` and `callVisionLLM` are the same
+    // `await loadConfig(); getModel();` pair as the primary route above — one
+    // argument each, and fixing only `getConfiguredModel` would leave the bug
+    // live on the three busiest doors in the file.
+    await store(CUSTOM);
+    createOpenAIMock.mockClear();
+
+    await underStaleCache(() => callLLM("system", "user"));
+
+    expect(createOpenAIMock).toHaveBeenLastCalledWith({
+      apiKey: "sk-custom",
+      baseURL: "https://api.example/v1",
+    });
+    expect(lastGenerateArgs().model).toEqual({ id: "my-model", api: "chat" });
+  });
+
+  it("does the same for callLLMStream and callVisionLLM", async () => {
+    await store(CUSTOM);
+
+    createOpenAIMock.mockClear();
+    await underStaleCache(async () => callLLMStream("system", "user"));
+    expect(createOpenAIMock).toHaveBeenLastCalledWith({
+      apiKey: "sk-custom",
+      baseURL: "https://api.example/v1",
+    });
+
+    createOpenAIMock.mockClear();
+    await underStaleCache(() => callVisionLLM("describe", new Uint8Array([1, 2, 3])));
+    expect(createOpenAIMock).toHaveBeenLastCalledWith({
+      apiKey: "sk-custom",
+      baseURL: "https://api.example/v1",
+    });
+  });
+});
+
+describe("the LLM gate sees the workload selections too (DW-621)", () => {
+  it("passes for a store that selects Ollama through chatProvider alone", async () => {
+    // `chatProvider` is an independent route the workload resolvers honour, so
+    // this deployment IS configured. Asking only `cfg.provider` told it
+    // otherwise, and every LLM feature in the repo gates on this function — so
+    // Chat, ingest, lint, vision, search and the query route all silently
+    // skipped their LLM steps.
+    await store({ chatProvider: "ollama" });
+    expect(await hasLLMKey()).toBe(true);
+  });
+
+  it("passes for a configured Custom selected through ingestProvider alone", async () => {
+    await store({
+      ingestProvider: "custom",
+      customApiKey: "sk-custom",
+      customBaseUrl: "https://api.example/v1",
+    });
+    expect(await hasLLMKey()).toBe(true);
+  });
+
+  it("holds Custom's both-halves rule for a workload field too", async () => {
+    // The RULES are unchanged and asked of each selection in turn — only the
+    // set of fields they are asked about widened. A half-configured workload
+    // Custom is no more constructible than a half-configured primary one.
+    await store({ chatProvider: "custom", customApiKey: "sk-custom" });
+    expect(await hasLLMKey()).toBe(false);
+
+    await store({ chatProvider: "custom", customBaseUrl: "https://api.example/v1" });
+    expect(await hasLLMKey()).toBe(false);
+  });
+
+  it("still refuses a workload provider whose key is an env secret", async () => {
+    // The widening is about STORE-only providers. `openai` needs a server
+    // secret that is not there, so the gate stays closed and the resolver keeps
+    // refusing with the sentence DW-503 owns.
+    await store({ chatProvider: "openai", chatModel: "gpt-4o" });
+    expect(await hasLLMKey()).toBe(false);
+    await expect(getConfiguredModel({ workload: "chat" })).rejects.toThrow(
+      /is not configured on this server/,
+    );
+  });
+
+  it("still answers false for a store with no provider selection at all", async () => {
+    await store({ customApiKey: "sk-custom", customBaseUrl: "https://api.example/v1" });
+    expect(await hasLLMKey()).toBe(false);
+  });
+});
