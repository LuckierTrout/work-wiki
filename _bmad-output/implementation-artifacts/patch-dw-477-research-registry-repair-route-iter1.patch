+---
+title: 'Research registry: an owner-only quarantine-and-restart repair route for a wedged registry'
+type: 'feature'
+created: '2026-08-29'
+status: 'in-review'
+review_loop_iteration: 0
+followup_review_recommended: false
+context: []
