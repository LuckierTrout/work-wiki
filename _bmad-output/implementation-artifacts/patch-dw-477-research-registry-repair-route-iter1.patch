+        cas.mockRestore();
+      }
+
+      expect(await fs.readFile(registryPath("alice"), "utf-8")).toBe(raw);
+    });
+
+    it("surfaces the busy sentence when the CAS replace is lost", async () => {
+      const raw = JSON.stringify([{}]);
+      await seedRawRegistry("alice", raw);
+      const storage = getStorage();
+      const cas = vi.spyOn(storage, "writeFileIfMatch").mockResolvedValue(false);
+
+      try {
+        // The EXISTING sentence, not a new one: this is the same contention
+        // `applyResearchProjectMutation` already reports.
+        await expect(repairResearchRegistry("alice")).rejects.toThrow(
+          "Research projects were busy; retry the request.",
+        );
+      } finally {
+        cas.mockRestore();
+      }
+
+      // A quarantine copy orphaned by a lost CAS is harmless — a duplicate of
+      // bytes another repair already saved — and the registry is untouched.
+      expect(await fs.readFile(registryPath("alice"), "utf-8")).toBe(raw);
+    });
+
+    it("refuses on a read-only deployment before reading or writing anything", async () => {
+      // DW-385 stays unconditional: a read-only deployment refuses the repair
+      // even while the registry is wedged. Leaving read-only is the fix.
+      const raw = JSON.stringify([{}]);
+      await seedRawRegistry("alice", raw);
+      const storage = getStorage();
+      const touched = [
+        vi.spyOn(storage, "readFileWithEtag"),
+        vi.spyOn(storage, "writeFile"),
+        vi.spyOn(storage, "writeFileIfMatch"),
+      ];
+      const saved = process.env.YOPEDIA_READONLY;
+      process.env.YOPEDIA_READONLY = "1";
+
+      try {
+        await expect(repairResearchRegistry("alice")).rejects.toThrow(
+          READ_ONLY_REFUSAL.researchMutate,
+        );
+        for (const spy of touched) expect(spy).not.toHaveBeenCalled();
+      } finally {
+        if (saved === undefined) delete process.env.YOPEDIA_READONLY;
+        else process.env.YOPEDIA_READONLY = saved;
+        for (const spy of touched) spy.mockRestore();
+      }
+
+      expect(await fs.readFile(registryPath("alice"), "utf-8")).toBe(raw);
+    });
+
+    it.each([
+      ["a non-list registry", '{"projects":[]}', "Research projects file is not a list."],
+      ["a bad-element registry", JSON.stringify([{}]), "Research project entry 0 is invalid."],
+    ])("names the repair route in the %s refusal", async (_label, raw, sentence) => {
+      await seedRawRegistry("alice", raw);
+
+      // The refusal is the ONLY place an operator learns the route exists — the
+      // wedged registry 500s every door that could have shown it. Each keeps
+      // its leading diagnosis verbatim and gains the hint as a suffix.
+      await expect(listResearchProjects("alice")).rejects.toThrow(sentence);
+      await expect(listResearchProjects("alice")).rejects.toThrow(
+        "POST /api/research/repair",
+      );
+      await expect(listResearchProjects("alice")).rejects.toThrow(
+        `${sentence} Repair it with POST /api/research/repair, then retry.`,
+      );
+    });
+  });
 });
