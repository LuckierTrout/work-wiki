+/**
+ * `POST /api/research/repair` — the owner's way out of a wedged registry (DW-477).
+ *
+ * An unreadable `research-projects.json` refuses at both read sites, so every
+ * research door 500s for that tenant — the deletes that could shrink the file
+ * included. This door quarantines the unreadable bytes and starts a fresh empty
+ * registry, and it is the door `parseRegistry`'s two refusals name.
+ *
+ * A STATIC segment, so Next.js routes it ahead of the sibling `[id]` (which has
+ * no POST in any case) — `repair` can never be read as a project id.
+ *
+ * Owner-only means the door's own principal: the tenant path is derived from
+ * `principal.handle` inside the store, so there is no field a caller could set
+ * to name another tenant's registry.
+ */
+import { NextResponse } from "next/server";
+import { getPrincipal } from "@/lib/auth";
+import { isReadOnly } from "@/lib/config";
+import { getErrorMessage } from "@/lib/errors";
+import { READ_ONLY_REFUSAL } from "@/lib/read-only";
+import { repairResearchRegistry } from "@/lib/research-projects";
+
+/**
+ * The 409 body. 409 rather than 200-with-a-flag because the request conflicts
+ * with the registry's actual state — the code `/api/research/[id]` already uses
+ * for "this cannot be edited" — and rather than 400 because the caller sent
+ * nothing wrong.
+ */
+const NOTHING_TO_REPAIR =
+  "The research projects file reads fine; there is nothing to repair.";
+
+export async function POST() {
+  const principal = await getPrincipal();
+  if (!principal) return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+  // Deployment read-only (DW-294/DW-385). Ordered after the 401 so a signed-out
+  // caller still learns it is signed out, and before the store call so nothing
+  // is read or written on a deployment about to refuse. `repairResearchRegistry`
+  // gates in the kernel on the same sentence for a direct library caller.
+  if (isReadOnly()) {
+    return NextResponse.json(
+      { error: READ_ONLY_REFUSAL.researchMutate },
+      { status: 403 },
+    );
+  }
+  try {
+    // A discriminated union, not a message match: the door has to tell a
+    // refusal from a fault, and DW-296 deleted message matching from this
+    // module's doors for good.
+    const result = await repairResearchRegistry(principal.handle);
+    if (!result.quarantined) {
+      return NextResponse.json({ error: NOTHING_TO_REPAIR }, { status: 409 });
+    }
+    return NextResponse.json({ repaired: true, quarantinedPath: result.path });
+  } catch (error) {
+    // No `ClientInputError` branch: nothing on this path throws one — the body
+    // is not read at all, and the store's only throws are the storage fault and
+    // the busy sentence. A dead 400 branch was rejected for `/api/research/[id]`
+    // for the same reason.
+    return NextResponse.json({ error: getErrorMessage(error) }, { status: 500 });
+  }
+}
