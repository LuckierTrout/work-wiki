+/**
+ * `POST /api/research/repair` — the door onto DW-477's registry repair.
+ *
+ * The `research-route.test.ts` recipe: `@/lib/auth` mocked, the store mocked
+ * over its real module so only `repairResearchRegistry` is a stub, the handler
+ * imported directly. What is pinned here is the door's own mapping — 401, the
+ * read-only 403 asserted against the CONSTANT, 200 with the quarantined path,
+ * 409 for "nothing to repair" and 500 for a storage fault — not the store's
+ * behaviour, which `research-projects.test.ts` owns against real bytes.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/auth", () => ({ getPrincipal: vi.fn() }));
+vi.mock("@/lib/research-projects", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("@/lib/research-projects")>();
+  return { ...actual, repairResearchRegistry: vi.fn() };
+});
+
+import { POST } from "@/app/api/research/repair/route";
+import { getPrincipal } from "@/lib/auth";
+import { READ_ONLY_REFUSAL } from "@/lib/read-only";
+import { repairResearchRegistry } from "@/lib/research-projects";
+
+const mockedPrincipal = vi.mocked(getPrincipal);
+const mockedRepair = vi.mocked(repairResearchRegistry);
+
+describe("POST /api/research/repair", () => {
+  let savedReadOnly: string | undefined;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    savedReadOnly = process.env.YOPEDIA_READONLY;
+    // Cleared rather than inherited: a value exported in a developer's shell
+    // would otherwise turn every case below into a 403.
+    delete process.env.YOPEDIA_READONLY;
+    mockedPrincipal.mockResolvedValue({ handle: "alice" } as Awaited<
+      ReturnType<typeof getPrincipal>
+    >);
+  });
+
+  afterEach(() => {
+    if (savedReadOnly === undefined) delete process.env.YOPEDIA_READONLY;
+    else process.env.YOPEDIA_READONLY = savedReadOnly;
+  });
+
+  it("401s an unauthenticated caller without reaching the store", async () => {
+    mockedPrincipal.mockResolvedValue(null);
+
+    const response = await POST();
+
+    expect(response.status).toBe(401);
+    expect(await response.json()).toEqual({ error: "Sign in required." });
+    expect(mockedRepair).not.toHaveBeenCalled();
+  });
+
+  it("403s a read-only deployment with the shared researchMutate sentence", async () => {
+    // Deliberate: a read-only deployment refuses the repair even though the
+    // registry is wedged. Read-only is an operator-chosen state, and the fix is
+    // to leave it, not to carve an exception into the one unconditional gate.
+    process.env.YOPEDIA_READONLY = "1";
+
+    const response = await POST();
+
+    expect(response.status).toBe(403);
+    expect(await response.json()).toEqual({ error: READ_ONLY_REFUSAL.researchMutate });
+    expect(mockedRepair).not.toHaveBeenCalled();
+  });
+
+  it("still 401s an unauthenticated caller on a read-only deployment", async () => {
+    // The gate sits AFTER the 401, so a signed-out caller learns it is signed
+    // out rather than being told about a deployment state it cannot see.
+    process.env.YOPEDIA_READONLY = "1";
+    mockedPrincipal.mockResolvedValue(null);
+
+    expect((await POST()).status).toBe(401);
+    expect(mockedRepair).not.toHaveBeenCalled();
+  });
+
+  it("200s with the quarantined path, repairing the door's OWN principal", async () => {
+    mockedRepair.mockResolvedValue({
+      quarantined: true,
+      path: "tenants/alice/research-projects.json.corrupt-1700000000000",
+    });
+
+    const response = await POST();
+
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      repaired: true,
+      quarantinedPath: "tenants/alice/research-projects.json.corrupt-1700000000000",
+    });
+    // Owner-only: the tenant comes from the principal, never from the request,
+    // so no caller can name another tenant's registry.
+    expect(mockedRepair).toHaveBeenCalledWith("alice");
+  });
+
+  it("409s when the store reports nothing to repair", async () => {
+    // A readable (or absent) registry is a CONFLICT with the request, not a
+    // fault and not bad input — the code `/api/research/[id]` already uses for
+    // "this cannot be edited".
+    mockedRepair.mockResolvedValue({ quarantined: false });
+
+    const response = await POST();
+
+    expect(response.status).toBe(409);
+    expect(await response.json()).toEqual({
+      error: "The research projects file reads fine; there is nothing to repair.",
+    });
+  });
+
+  it("500s a storage failure", async () => {
+    // A failed quarantine write is the case: the store propagates rather than
+    // replacing bytes nothing saved, and the door reports the fault verbatim.
+    mockedRepair.mockRejectedValue(new Error("disk full"));
+
+    const response = await POST();
+
+    expect(response.status).toBe(500);
+    expect(await response.json()).toEqual({ error: "disk full" });
+  });
+
+  it("500s the busy sentence rather than classifying it as caller input", async () => {
+    mockedRepair.mockRejectedValue(new Error("Research projects were busy; retry the request."));
+
+    const response = await POST();
+
+    expect(response.status).toBe(500);
+    expect(await response.json()).toEqual({
+      error: "Research projects were busy; retry the request.",
+    });
+  });
+});
