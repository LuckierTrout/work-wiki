+/** What {@link repairResearchRegistry} did, told apart without message matching. */
+export type ResearchRegistryRepair =
+  | { quarantined: true; path: string }
+  | { quarantined: false };
+
+/**
+ * Quarantine an UNREADABLE registry and start a fresh empty one (DW-477).
+ *
+ * The missing half of DW-297/DW-476. Refusing an unreadable registry at both
+ * read sites is right — the projects are not gone, they are unreadable — but it
+ * wedges the tenant: every research door 500s, the deletes that could shrink
+ * the file included, so the owner had no in-product way out. This is that way
+ * out, and `POST /api/research/repair` is the door onto it.
+ *
+ * WHY A READABLE REGISTRY IS REFUSED, and why that is the whole safety
+ * property. The repair re-parses through the SAME {@link parseRegistry} every
+ * read goes through, and returns `{ quarantined: false }` the moment it
+ * succeeds. So there is no ordering in which a parse succeeds and the bytes are
+ * still replaced — a healthy registry, an empty-list one and a fully tombstoned
+ * one all leave here byte-identical with nothing written. An owner who guesses
+ * at this route while nothing is wrong loses nothing; that is what makes it
+ * safe to name in a 500 body.
+ *
+ * An ABSENT registry (ENOENT) is not a repair either: nothing is wedged and
+ * there is nothing to quarantine, so it answers the same "nothing to repair"
+ * rather than writing a fresh file the tenant never had. A storage read fault
+ * that is NOT ENOENT is rethrown untouched — a provider hiccup is not a corrupt
+ * file, and treating it as one would quarantine bytes that were never read.
+ *
+ * "UNREADABLE" INCLUDES `JSON.parse`'s raw `SyntaxError`. Truncated bytes are
+ * exactly the case this route exists for, and they never reach the shape
+ * checks.
+ *
+ * WHY THE QUARANTINE IS WRITTEN FIRST. See the ordering note at the write
+ * below. WHY THE COPY IS NEVER PRUNED: it is the tenant's only remaining handle
+ * on those bytes. Nothing here deletes an older `.corrupt-*` sibling, and no
+ * schedule reaps them — a repair that tidied away the previous rescue would
+ * turn a second wedge into permanent loss of the first.
+ *
+ * Read-only gated in the KERNEL as well as at the door (DW-385), reusing
+ * {@link READ_ONLY_REFUSAL.researchMutate}: repairing is "change my research",
+ * the capability that sentence already groups. A read-only deployment therefore
+ * refuses the repair even while the registry is wedged — read-only is an
+ * operator-chosen state, and the fix is to leave it, not to carve the one
+ * unconditional gate open.
+ */
+export async function repairResearchRegistry(owner: string): Promise<ResearchRegistryRepair> {
+  // Deployment read-only (DW-385), FIRST — ahead of the lock and of any read,
+  // the shape `deleteResearchProject` uses.
+  assertWritable(READ_ONLY_REFUSAL.researchMutate);
+  const storage = getStorage();
+  const path = projectPath(owner);
+  return withFileLock(lockKey(owner), async () => {
+    let read: FileWithEtag;
+    try {
+      read = await storage.readFileWithEtag(path);
+    } catch (error) {
+      // ENOENT is "nothing to repair"; anything else is a storage fault and
+      // must surface as a 500 without a byte being touched.
+      if (isEnoent(error)) return { quarantined: false };
+      throw error;
+    }
+    let readable = true;
+    try {
+      parseRegistry(read.content);
+    } catch {
+      // Any throw at all, `JSON.parse`'s own `SyntaxError` included.
+      readable = false;
+    }
+    if (readable) return { quarantined: false };
+    // The copy is the tenant's only remaining handle on these bytes, so it lands
+    // first and its failure propagates. Replacing first and copying after would
+    // turn one storage hiccup into permanent loss of the very file the owner came
+    // here to rescue. A quarantine copy orphaned by a lost CAS is harmless — it is
+    // a duplicate of bytes another repair already saved. The key shape is
+    // `review-queue.ts`'s, so both stores' quarantines read the same beside their
+    // originals under `tenants/<t>/`.
+    const quarantinePath = `${path}.corrupt-${Date.now()}`;
+    await storage.writeFile(quarantinePath, read.content);
+    // CAS against the etag from the read above, so a concurrent writer that
+    // fixed the file between the two is not blind-written over. The existing
+    // busy sentence rather than a new one — this is the same contention
+    // `applyResearchProjectMutation` reports.
+    const wrote = await storage.writeFileIfMatch(path, serializeProjects([]), read.etag);
+    if (!wrote) throw new Error("Research projects were busy; retry the request.");
+    return { quarantined: true, path: quarantinePath };
+  });
+}
+
 export async function listResearchProjects(owner: string): Promise<ResearchProject[]> {
   return (await readProjects(owner)).sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
 }
