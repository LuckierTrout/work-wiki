{
  "name": "yopedia",
  "version": "1.0.0",
  "description": "A wiki for the agent age — read and write knowledge pages via MCP",
  "transport": "stdio",
  "command": "npx",
  "args": ["tsx", "src/mcp.ts"],
  "tools": [
    "search_wiki",
    "read_page",
    "list_pages",
    "create_page",
    "update_page",
    "delete_page",
    "ingest_url",
    "query_wiki",
    "agent_context",
    "seed_agent",
    "lint_wiki",
    "fix_lint_issue",
    "list_discussions",
    "create_discussion",
    "resolve_discussion",
    "add_comment",
    "reingest"
  ]
}
