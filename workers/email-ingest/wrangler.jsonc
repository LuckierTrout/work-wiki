{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yopedia-email-ingest",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "YOPEDIA_CONFIG",
      "id": "874e4a8165ff4725ad24b4dfd62d479b"
    }
  ],
  "services": [
    {
      "binding": "YOPEDIA",
      "service": "yopedia"
    }
  ],
  "vars": {
    "YOPEDIA_SITE_URL": "https://yopedia.christianlee-flightwall.workers.dev"
  }
  // Secret (set with `wrangler secret put --config workers/email-ingest/wrangler.jsonc`):
  //   YOPEDIA_SERVICE_TOKEN — same value as the main and task-consumer Workers.
}
